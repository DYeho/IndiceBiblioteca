{
  "name": "indice-biblioteca",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo digital para una biblioteca estudiantil.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
