# Copie este archivo como .env y complete los valores. .env NO se versiona.
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/library.sqlite
SESSIONS_DIR=data
SESSIONS_DB=sessions.sqlite
# Cadena larga y aleatoria (mínimo 32 caracteres). Genérela con:
#   node -p "require('node:crypto').randomBytes(48).toString('hex')"
SESSION_SECRET=
# 1 solo cuando hay un proxy inverso (Nginx) delante. Por defecto 0.
TRUST_PROXY=0
# Origen exacto desde el que se abre la aplicación (sin barra final).
ALLOWED_ORIGIN=http://localhost:3000